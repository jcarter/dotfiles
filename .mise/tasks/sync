#!/usr/bin/env bash
#MISE description="Fast-forward the repository and converge this Mac"
set -euo pipefail

source "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}/lib/utils.sh"
cd "$DOTFILES_REPO_ROOT"

if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    printf '%s\n' 'Refusing to sync a dirty worktree. Commit, stash, or remove local changes first.' >&2
    exit 1
fi

git pull --ff-only
mise bootstrap
