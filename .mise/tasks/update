#!/usr/bin/env bash
#MISE description="Upgrade mise, its tools, and declared brew casks."
set -euo pipefail

source "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}/lib/utils.sh"

"$DOTFILES_REPO_ROOT/.mise/tasks/install-mise" --update
export PATH="$HOME/.local/bin:$PATH"
"$DOTFILES_REPO_ROOT/.mise/tasks/brew-bundle" --upgrade
cd "$DOTFILES_REPO_ROOT"
mise upgrade
mise bootstrap
