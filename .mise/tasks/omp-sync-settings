#!/usr/bin/env bash
#MISE description="Copy live values of the shared OMP keys back to templates/omp/config.yml"
set -euo pipefail

live_config="$HOME/.omp/agent/config.yml"
shared_source="$MISE_PROJECT_ROOT/templates/omp/config.yml"

if [[ ! -f "$live_config" ]]; then
    printf 'No live OMP config at %s; run mise bootstrap first.\n' "$live_config" >&2
    exit 1
fi

# For each non-map key the shared source declares, take a differing live value; role, model, and secret keys never qualify.
sync_expression='
select(fi == 1) as $live
| select(fi == 0)
| (.. | select(tag != "!!map" and (parent | tag) == "!!map") | path
    | select((.[0] == "modelRoles" or .[0] == "memory" or (.[0] == "hindsight" and .[1] == "apiUrl")) | not)
  ) as $p ireduce (.;
    ($p[:-1][] as $k ireduce ($live; .[$k])) as $parent
    | if ($parent | tag) == "!!map" and ($parent | has($p[-1]))
        and ($parent[$p[-1]] | to_json(0)) != ($p[] as $k ireduce (.; .[$k]) | to_json(0))
      then setpath($p; $parent[$p[-1]])
      else .
      end
  )
'

temporary_source="$(mktemp "$shared_source.XXXXXX")"
trap 'rm -f "$temporary_source"' EXIT
yq eval-all "$sync_expression" "$shared_source" "$live_config" > "$temporary_source"
chmod 644 "$temporary_source"
mv "$temporary_source" "$shared_source"
