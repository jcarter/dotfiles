#!/usr/bin/env bash
#MISE description="Copy every live OMP setting except the ignore list back to templates/omp/config.yml"
set -euo pipefail

live_config="$HOME/.omp/agent/config.yml"
shared_source="$MISE_PROJECT_ROOT/templates/omp/config.yml"
ignore_list="$MISE_PROJECT_ROOT/templates/omp/sync-ignore.txt"

if [[ ! -f "$live_config" ]]; then
    printf 'No live OMP config at %s; run mise bootstrap first.\n' "$live_config" >&2
    exit 1
fi

# Key paths without comments, whitespace, or blank lines.
sync_ignore="$(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$ignore_list")"
export sync_ignore

# Merge live into the template to keep its key order, drop keys live lacks, then drop ignored paths.
sync_expression='
select(fi == 1) as $live
| select(fi == 0)
| . * $live
| delpaths([.. | select((parent | tag) == "!!map") | path
    | select(. as $p | ($p[:-1][] as $k ireduce ($live; .[$k])) as $parent
        | (($parent | tag) == "!!map" and ($parent | has($p[-1]))) | not)])
| delpaths([strenv(sync_ignore) | split("\n")[] | select(. != "") | split(".")])
| if (.hindsight | tag) == "!!map" and (.hindsight | has("apiUrl"))
  then error("refusing to write hindsight.apiUrl to templates/omp/config.yml")
  else .
  end
'

temporary_source="$(mktemp "$shared_source.XXXXXX")"
trap 'rm -f "$temporary_source"' EXIT
yq eval-all "$sync_expression" "$shared_source" "$live_config" > "$temporary_source"
chmod 644 "$temporary_source"
mv "$temporary_source" "$shared_source"
