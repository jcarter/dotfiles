#!/usr/bin/env bash
#MISE description="Render OMP configuration for this machine role"

# Render OMP's live configuration from the committed, non-secret source. The
# machine role is deliberately supplied by mise from mise.local.toml.
set -euo pipefail

scriptPath="${BASH_SOURCE[0]}"
while [[ -L "$scriptPath" ]]; do
  linkDir="$(cd -P "$(dirname "$scriptPath")" && pwd)"
  linkTarget="$(readlink "$scriptPath")"
  if [[ "$linkTarget" == /* ]]; then
    scriptPath="$linkTarget"
  else
    scriptPath="$linkDir/$linkTarget"
  fi
done
scriptDir="$(cd -P "$(dirname "$scriptPath")" && pwd)"
source "$scriptDir/../../lib/omp.sh"
memoryBackend="$(omp_role_backend)"
role="${DOTFILES_ROLE:-}"
omp_init_paths "$scriptDir"

if [[ ! -f "$sourcePath" ]]; then
  printf 'OMP template not found: %s\n' "$sourcePath" >&2
  exit 1
fi

template="$(<"$sourcePath")"
if [[ "$template" != *"$ompBackendSentinel"* || "$template" != *"$ompHindsightSentinel"* ]]; then
  printf '%s\n' 'OMP template is missing a required renderer sentinel.' >&2
  exit 1
fi

if [[ "$role" == personal ]]; then
  hindsightApiUrl="$(omp_hindsight_api_url)"
  hindsightValue="$(omp_yaml_double_quote "$hindsightApiUrl")"
else
  hindsightValue='""'
fi

rendered="${template//$ompBackendSentinel/$memoryBackend}"
rendered="${rendered//$ompHindsightSentinel/$hindsightValue}"
if [[ "$rendered" == *"$ompBackendSentinel"* || "$rendered" == *"$ompHindsightSentinel"* ]]; then
  printf '%s\n' 'OMP renderer left an unresolved sentinel.' >&2
  exit 1
fi

omp_atomic_write "$rendered" "$liveConfigPath"
