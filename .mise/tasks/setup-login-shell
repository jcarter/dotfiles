#!/usr/bin/env bash
#MISE description="Set mise managed Fish as the login shell"
set -euo pipefail

if [[ ! -x "$HOME/.local/bin/mise" ]]; then
    printf '%s\n' 'mise is required. Run install.sh first.' >&2
    exit 1
fi
export PATH="$HOME/.local/bin:$PATH"

fishPath="$(mise which fish 2>/dev/null || true)"
if [[ ! -x "$fishPath" ]]; then
    printf '%s\n' 'Mise managed Fish was not found. Run `mise install fish` first.' >&2
    exit 1
fi

if ! grep -Fqx "$fishPath" /etc/shells; then
    printf '%s\n' "$fishPath" | sudo tee -a /etc/shells >/dev/null
fi

currentShell="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')"
if [[ "$currentShell" != "$fishPath" ]]; then
    chsh -s "$fishPath"
fi
